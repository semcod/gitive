# ---------------------------------------------------------------
# LLM access: litellm -> OpenRouter
# ---------------------------------------------------------------
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENROUTER_API_BASE=https://openrouter.ai/api/v1
OPENROUTER_SITE_URL=https://github.com/oqlos
OPENROUTER_APP_NAME=intuition-loop

# any litellm-routable model string; swap freely
INTUITION_MODEL=openrouter/anthropic/claude-3.5-sonnet
# INTUITION_MODEL=openrouter/qwen/qwen-2.5-coder-32b-instruct
# INTUITION_MODEL=ollama/qwen2.5-coder:14b        # fully local loop

# OpenRouter does not serve embeddings reliably.
# Leave EMPTY to use the built-in offline hashing embedder,
# or point at a real provider, e.g. openai/text-embedding-3-small
INTUITION_EMBED_MODEL=
# OPENAI_API_KEY=sk-...

# ---------------------------------------------------------------
# Model hyperparameters
# ---------------------------------------------------------------
INTUITION_DIM=512
INTUITION_HALF_LIFE_DAYS=14      # memory kernel lambda
INTUITION_TAU=0.7                # softmax temperature: explore vs exploit
INTUITION_FRICTION_WEIGHT=1.0    # mu: pull of CI failures on the tension vector
INTUITION_ALIGN_FLOOR=0.30       # gate before surprise counts
INTUITION_HORIZON_DAYS=14        # feedback labelling window
INTUITION_LR=0.05                # SGD step for theta

# ---------------------------------------------------------------
# Loop safety
# ---------------------------------------------------------------
INTUITION_MAX_OPEN=5             # hard WIP limit on open generated issues
INTUITION_PER_CYCLE=2            # issues opened per cycle
INTUITION_N_CANDIDATES=8         # candidates the LLM proposes per cycle
INTUITION_CI_LOOKBACK=20
INTUITION_GIT_LOOKBACK=200
INTUITION_LABEL=intuition
INTUITION_DRY_RUN=false
