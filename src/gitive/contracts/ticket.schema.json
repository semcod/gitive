{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Gitive ticket v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "project_ref": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{1,63}$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "draft",
        "planned",
        "in_progress",
        "verifying",
        "pr_open",
        "blocked",
        "merged",
        "released"
      ]
    },
    "objective": {
      "type": "string",
      "minLength": 1
    },
    "acceptance": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "allowed_paths": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
      }
    },
    "environment_receipt": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "benchmark_receipt": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "executor": {
      "enum": [
        null,
        "glm53",
        "gpt6",
        "opus5"
      ]
    },
    "git": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "base_sha": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{40,64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "head_sha": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{40,64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "branch": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "base_sha",
        "head_sha",
        "branch"
      ]
    },
    "github": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "issue": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "pr": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        }
      },
      "required": [
        "issue",
        "pr"
      ]
    },
    "verification_receipt": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "merge_receipt": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "release_tag": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "schema_version",
    "id",
    "project_ref",
    "title",
    "status",
    "objective",
    "acceptance",
    "allowed_paths",
    "environment_receipt",
    "benchmark_receipt",
    "executor",
    "git",
    "github",
    "verification_receipt",
    "merge_receipt",
    "release_tag"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "merged",
              "released"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "merge_receipt": {
            "type": "string"
          },
          "verification_receipt": {
            "type": "string"
          },
          "github": {
            "properties": {
              "pr": {
                "type": "integer"
              }
            }
          },
          "git": {
            "properties": {
              "head_sha": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "released"
          }
        }
      },
      "then": {
        "properties": {
          "release_tag": {
            "type": "string"
          }
        }
      }
    }
  ]
}
