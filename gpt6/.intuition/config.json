{
  "schema_version": 2,
  "goal": "Improve reliability and maintainability without changing public behavior. Prefer evidence-backed minimal changes; return no task when evidence is insufficient.",
  "memory_branch": "intuition-memory",
  "allowed_paths": ["demo_app/*.py", "python/engine.py", "typescript/engine.ts"],
  "accepted_workflows": [".github/workflows/ci.yml", ".github/workflows/cd.yml", ".github/workflows/verify-candidate.yml"],
  "max_calls_per_day": 8,
  "max_calls_per_cycle": 2,
  "max_new_issues_per_cycle": 1,
  "max_open_issues": 4,
  "max_open_prs": 1,
  "max_attempts_per_issue": 2,
  "max_failures_before_pause": 3,
  "max_runs_per_cycle": 6,
  "max_context_facts": 24,
  "max_log_chars": 16000,
  "max_input_chars": 100000,
  "max_output_tokens": 4096,
  "max_files_per_patch": 3,
  "max_patch_changed_lines": 250,
  "max_file_bytes": 64000,
  "task_cooldown_days": 7,
  "max_risk": 0.2,
  "min_score": 0.05,
  "profiles": {
    "repair": {"alpha": 4, "beta": 2, "benefit": 0.9, "cost": 0.2, "risk": 0.1},
    "refactor": {"alpha": 4, "beta": 2, "benefit": 0.6, "cost": 0.2, "risk": 0.08}
  }
}
