# Local only. Never commit a populated .env and never use `source .env`.
# Actions receive equivalent settings through env + Secrets/Variables.
GITHUB_REPOSITORY=OWNER/REPOSITORY
# Leave blank when using interactive `gh auth login` locally.
GH_TOKEN=
OPENROUTER_API_KEY=
OPENROUTER_API_BASE=https://openrouter.ai/api/v1
LLM_MODEL=openrouter/z-ai/glm-5.3
LLM_REASONING_EFFORT=low
OR_SITE_URL=https://github.com
OR_APP_NAME=Intuition-GitHub
LLM_TIMEOUT_SECONDS=120
LLM_JSON_MODE=true
# First perform `cycle` (dry run); enable writes deliberately.
INTUITION_ENABLED=false
# Optional, fails closed without strict protected-branch checks.
INTUITION_AUTOMERGE=false
